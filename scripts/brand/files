# Which files this repository takes from braidkit/brand, and where they go.
#
# This repository owns this map because it knows its own layout. The mechanism
# lives in braidkit/brand (vendor.py); running it there refreshes these copies.
#
# A source ending in / is a directory: every committed file under it travels,
# so a font or an icon added upstream arrives without this file being touched.
# Naming a single file takes that file alone.
#
# Never edit a vendored copy in place. It builds clean, passes review, and is
# then silently reverted the next time anyone vendors. scripts/brand/check.py
# fails CI when that happens, and travels under the lock itself.

tokens/ -> docs/stylesheets/
fonts/  -> docs/assets/fonts/
icons/  -> docs/assets/brand/icons/

# The header wordmark, referenced by theme.logo in mkdocs.yml. A file line
# rather than logo/, which carries every mark and avatar variant.
logo/braid-mark-purple-512.png -> docs/assets/brand/logo/braid-mark-purple-512.png

# The CI check itself, vendored like everything else.
consumer/check.py -> scripts/brand/check.py

# The design rules, so they are readable here without network access to a
# private repository. AGENTS.md points at this copy.
DESIGN.md -> scripts/brand/DESIGN.md
