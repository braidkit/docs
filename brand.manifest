# Shared brand files this repository vendors.
#
# Masters live in braidkit/ops under brand/. Left of the arrow is the path
# there; right of it is where the copy goes here.
#
#   scripts/sync-brand.py            pull the latest and update brand.lock
#   scripts/sync-brand.py --check    verify the copies (runs in CI)
#   scripts/sync-brand.py --status   ask whether upstream has moved
#
# Never edit a vendored file here. Change it upstream and re-sync, or the next
# sync silently reverts you.

tokens/braid-tokens.css       -> docs/stylesheets/braid-tokens.css

icons/icon.svg                -> docs/assets/brand/icons/icon.svg
icons/favicon.ico             -> docs/assets/brand/icons/favicon.ico
icons/apple-touch-icon.png    -> docs/assets/brand/icons/apple-touch-icon.png

fonts/archivo-variable.woff2  -> docs/assets/fonts/archivo-variable.woff2
fonts/jetbrains-mono.woff2    -> docs/assets/fonts/jetbrains-mono.woff2
fonts/OFL.txt                 -> docs/assets/fonts/OFL.txt
