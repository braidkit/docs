# Which files this repository takes from braidkit/brand, and where they go.
#
# This repository owns this map because it knows its own layout. The mechanism
# lives in braidkit/brand (sync.py); a workflow there opens a pull request here
# whenever one of these files changes.
#
# Never edit a vendored copy in place. It builds clean, passes review, and is
# then silently overwritten by the next propagation. scripts/check-brand.py
# fails CI when that happens.

tokens/braid-tokens.css       -> docs/stylesheets/braid-tokens.css

icons/icon.svg                -> docs/assets/brand/icons/icon.svg
icons/favicon.ico             -> docs/assets/brand/icons/favicon.ico
icons/apple-touch-icon.png    -> docs/assets/brand/icons/apple-touch-icon.png

fonts/archivo-variable.woff2  -> docs/assets/fonts/archivo-variable.woff2
fonts/jetbrains-mono.woff2    -> docs/assets/fonts/jetbrains-mono.woff2
fonts/OFL.txt                 -> docs/assets/fonts/OFL.txt
